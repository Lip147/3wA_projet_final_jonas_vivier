APP_ENV=development

DB_HOST=localhost
DB_NAME=mamie_gallery
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# false en local avec HTTP, true en production avec HTTPS
SESSION_SECURE=false
SESSION_SAVE_PATH=storage/sessions

MAX_IMAGE_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=40000000

CONTACT_MIN_SECONDS=3
CONTACT_RATE_LIMIT_SECRET=
CONTACT_RATE_WINDOW_SECONDS=900
CONTACT_SESSION_LIMIT=3
CONTACT_IP_LIMIT=5

# Generez une valeur aleatoire d'au moins 32 caracteres pour chaque environnement.
LOGIN_RATE_LIMIT_SECRET=
LOGIN_RATE_WINDOW_SECONDS=900
LOGIN_SESSION_LIMIT=5
LOGIN_IP_LIMIT=10

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="Site Annie Roger Chamoulaud"
MAIL_OWNER_EMAIL=
MAIL_OWNER_NAME=

PHP_BINARY="C:\xampp\php\php.exe"
